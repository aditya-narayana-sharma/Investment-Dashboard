# Server-only Supabase (Algorithm Canvas library). Never prefix these with NEXT_PUBLIC_.
# Copy to .env.local (gitignored).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stratji v1 license (honor + key file). Auth0 is not required for Mac.
# Key format: stratji-basic-<token> | stratji-pro-<token> | stratji-ultra-<token>
STRATJI_LICENSE_TIER=basic
STRATJI_LICENSE_KEY=

# Optional on-device LLM keys. Paste locally in Settings or here. Empty = LLM assist disabled.
# Never commit real keys. GitHub clones stay empty.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
CURSOR_API_KEY=

# Optional Auth0 (unused on Mac when Auth0.plist still has YOUR_ placeholders).
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://127.0.0.1:5050
AUTH0_AUTHOR_EMAIL=
AUTH0_SESSION_SECRET=
