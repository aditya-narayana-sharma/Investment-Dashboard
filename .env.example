# Server-only Supabase (Algorithm Canvas library). Never prefix these with NEXT_PUBLIC_.
# Copy to .env.local (gitignored).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stratji v1 license (honor + key file). Auth0 is not required for Mac.
# Key format: stratji-basic-<token> | stratji-pro-<token> | stratji-ultra-<token>
STRATJI_LICENSE_TIER=basic
STRATJI_LICENSE_KEY=

# Optional on-device LLM keys. Paste locally in Settings or here. Empty = LLM assist disabled.
# Never commit real keys. GitHub clones stay empty.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
CURSOR_API_KEY=

# Optional Auth0 (unused on Mac when Auth0.plist still has YOUR_ placeholders).
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://127.0.0.1:5050
AUTH0_AUTHOR_EMAIL=
AUTH0_SESSION_SECRET=

# ─── Zerodha Kite (live portfolio) ────────────────────────────────────────────
# Path to your local kite-mcp-server checkout. Optional when it sits beside this
# repository (../kite-mcp-server); required otherwise.
KITE_MCP_PROJECT_DIR=
# Where the Kite MCP server listens. Default: http://127.0.0.1:8080/mcp
KITE_MCP_URL=
# Where Stratji caches the MCP session id. Never the broker access token —
# kite-mcp-server owns that in ~/.kite-mcp/daily-access-token.json.
KITE_DASHBOARD_SESSION_PATH=

# ─── Groww (read-only holdings, positions, orders) ────────────────────────────
# Leave empty to disable Groww. Stratji never places Groww orders.
GROWW_ACCESS_TOKEN=
GROWW_BASE_URL=

# ─── Axis Research ────────────────────────────────────────────────────────────
# Curated local PDF archive.
AXIS_PDF_ARCHIVE_PATH=
# Where PDFs saved out of the Axis Research mailbox are stored.
# Default: artifacts/private/satya/axis-pdf (gitignored).
AXIS_MAIL_PDF_STORE_PATH=
# Apple Mail account and mailbox names. Defaults: iCloud / "Axis Research".
AXIS_MAIL_ACCOUNT=
AXIS_MAIL_MAILBOX=
# Set to 1 to OCR scanned Axis PDFs that carry no text layer.
SATYA_OCR_ENABLED=

# ─── Local LLM endpoint (optional) ────────────────────────────────────────────
# Ollama-compatible endpoint. With no provider configured, Satya and the macro
# evidence ranking fall back to deterministic rules and label themselves so.
OLLAMA_URL=
# Local podcast summariser. No model configured = no generated summaries.
PODCAST_SUMMARIZER_MODEL=
PODCAST_SUMMARIZER_URL=
PODCAST_SUMMARIZER_ALLOW_REMOTE=

# ─── Apple sources (macOS only) ───────────────────────────────────────────────
APPLE_HEALTH_EXPORT_DIR=
APPLE_EARNINGS_CALENDAR_NAME=

# ─── Local services ───────────────────────────────────────────────────────────
CONTENT_DIGEST_PORT=
CONTENT_DIGEST_URL=
PDF_DOWNLOAD_PORT=
PDF_CHROME_PATH=
PDF_GHOSTSCRIPT_PATH=
PORTFOLIO_FLASK_VENV=
PORTFOLIO_SECTOR_PYTHON=
