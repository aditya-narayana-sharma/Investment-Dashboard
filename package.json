{
  "name": "stratji",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "./scripts/ensure-kite-server.sh && ./scripts/ensure-pdf-download-server.sh && ./scripts/ensure-content-digest-server.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "predev:lan": "./scripts/ensure-kite-server.sh && ./scripts/ensure-pdf-download-server.sh && ./scripts/ensure-content-digest-server.sh",
    "dev:lan": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --hostname 0.0.0.0",
    "flask:setup": "./scripts/setup-flask-app.sh",
    "flask": "./scripts/start-remote-app.sh",
    "flask:stop": "./scripts/stop-flask-app.sh",
    "desktop": "./scripts/install-desktop-app.sh",
    "desktop:macos": "./scripts/install-stratji-macos.sh",
    "desktop:chrome": "./scripts/install-desktop-app.sh --chrome",
    "iphone": "./scripts/install-iphone-app.sh",
    "iphone:native": "./scripts/build-and-install-iphone-app.sh",
    "iphone:native:test": "./scripts/test-iphone-app.sh",
    "iphone:pair": "./scripts/generate-health-pairing-code.sh",
    "remote": "./scripts/start-remote-app.sh",
    "iphone:vinext": "./scripts/start-iphone-app.sh",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "prestart": "./scripts/ensure-kite-server.sh && ./scripts/ensure-pdf-download-server.sh && ./scripts/ensure-content-digest-server.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start --hostname 127.0.0.1",
    "test": "npm run build && npm run test:node && npm run test:python",
    "test:node": "node --experimental-strip-types --import ./tests/helpers/register-ts-ext.mjs --test tests/*.test.mjs",
    "test:python": "python3 -m unittest discover -s tests -p 'test_health_import.py'",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "flask:service": "./scripts/start-flask-app.sh",
    "content:refresh": "./scripts/refresh-content-digest.sh",
    "demo:record": "node scripts/record-demo-video.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.24.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-loading-skeleton": "3.5.0",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "playwright": "^1.55.0",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "description": "Stratji - a local-first Indian equity research and portfolio intelligence desktop app (Kite + Groww, Axis Research, sector analytics, strategy builder).",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Aditya Sharma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adityasharma/stratji.git"
  },
  "homepage": "https://stratji.co.in"
}
