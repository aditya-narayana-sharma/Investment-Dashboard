{
  "name": "kite-connect-mcp-server",
  "version": "0.1.0",
  "description": "Model Context Protocol server for Zerodha Kite Connect v3.",
  "type": "module",
  "bin": {
    "kite-connect-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
