# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
.firecrawl/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/
/tmp/
/artifacts/private/
# Satya FTS corpus and catalog (private mail index; also covered by /artifacts/private/)
/artifacts/private/satya/
/artifacts/demo/*.webm
/artifacts/demo/*.mp4

# local Flask gateway runtime
/.venv-flask/
__pycache__/
*.py[cod]

# Apple app user and build state
**/xcuserdata/
**/*.xcuserstate
/apple-app/DerivedData/
/apple-app/DerivedDataIOS/
/apple-app/DerivedDataIOS2/
/apple-app/build/
